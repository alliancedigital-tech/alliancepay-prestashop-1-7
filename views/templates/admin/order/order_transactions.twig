<div class="tab-pane fade" id="alliancepay-tab" role="tabpanel" aria-labelledby="alliancepay-tab-link">
<div class="card">
    <h3 class="card-header">
        <i class="material-icons">sync</i>
        Alliance Transaction Info
    </h3>

    <div class="card-body">
        <table class="table" id="extra-table">
            <thead>
            <tr>
                <th>Operation type</th>
                <th>Operation ID</th>
                <th>Date</th>
                <th>Status</th>
            </tr>
            </thead>
            <tbody>
            {% for operation in operations %}
                <tr>
                    <td>{{ operation.type }}</td>
                    <td>{{ operation.operationId ?? 'N/A' }}</td>
                    <td>{{ operation.creationDateTime }}</td>
                    <td>
                        <span class="badge badge-info">{{ operation.status }}</span>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-muted text-center">
                        No data loaded
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <button class="btn btn-primary" id="sync-btn">
            Update from Alliance API
        </button>
    </div>
</div>
{% if fiscal is not null %}
<div class="card mt-3">
    <h3 class="card-header">
        <i class="material-icons">receipt</i>
        {{ 'Fiscalization'|trans({}, 'ModulesAlliancePayAdmin') }}
    </h3>

    <div class="card-body">
        {% if fiscal.error is defined and fiscal.error %}
            <div class="alert alert-danger mb-0">{{ 'Fiscalization data could not be loaded. Make sure the module is upgraded to the latest version and check the PrestaShop log.'|trans({}, 'ModulesAlliancePayAdmin') }}</div>
        {% else %}
        <table class="table">
            <thead>
            <tr>
                <th>{{ 'Operation type'|trans({}, 'ModulesAlliancePayAdmin') }}</th>
                <th>{{ 'Operation ID'|trans({}, 'ModulesAlliancePayAdmin') }}</th>
                <th>{{ 'Status'|trans({}, 'ModulesAlliancePayAdmin') }}</th>
                <th>{{ 'Fiscal number'|trans({}, 'ModulesAlliancePayAdmin') }}</th>
                <th>{{ 'Receipt'|trans({}, 'ModulesAlliancePayAdmin') }}</th>
                <th>{{ 'Fiscalization date'|trans({}, 'ModulesAlliancePayAdmin') }}</th>
                <th>{{ 'Error'|trans({}, 'ModulesAlliancePayAdmin') }}</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for row in fiscal.rows %}
                {% set record = row.record %}
                <tr>
                    <td>{{ row.type }}</td>
                    <td>{{ row.operationId }}</td>
                    <td>
                        {% if record %}
                            <span class="badge badge-{{ record.status == 'SUCCESS' ? 'success' : (record.status == 'PENDING' ? 'info' : 'danger') }}">{{ record.status }}</span>
                        {% else %}
                            <span class="badge badge-secondary">{{ 'Not fiscalized'|trans({}, 'ModulesAlliancePayAdmin') }}</span>
                        {% endif %}
                    </td>
                    <td>{{ record ? record.fiscalNumber : '' }}</td>
                    <td>
                        {% if record and record.receiptUrl and (record.receiptUrl starts with 'https://' or record.receiptUrl starts with 'http://') %}
                            <a href="{{ record.receiptUrl }}" target="_blank" rel="noopener noreferrer">{{ 'Open'|trans({}, 'ModulesAlliancePayAdmin') }}</a>
                        {% endif %}
                    </td>
                    <td>{{ record and record.fiscalizationDateTime ? record.fiscalizationDateTime|date('Y-m-d H:i:s') : '' }}</td>
                    <td>{{ record and record.errorCode ? record.errorCode ~ ' ' ~ record.errorDescription : '' }}</td>
                    <td class="text-right">
                        {% if row.canFiscalize %}
                            <form method="post" action="{{ row.create_url }}" class="d-inline">
                                <input type="hidden" name="_csrf" value="{{ fiscal.csrf }}">
                                <button type="submit" class="btn btn-primary btn-sm">{{ 'Fiscalize'|trans({}, 'ModulesAlliancePayAdmin') }}</button>
                            </form>
                        {% endif %}
                        {% if row.canRefresh %}
                            <form method="post" action="{{ row.refresh_url }}" class="d-inline">
                                <input type="hidden" name="_csrf" value="{{ fiscal.csrf }}">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">{{ 'Refresh status'|trans({}, 'ModulesAlliancePayAdmin') }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-muted text-center">{{ 'No operations to fiscalize'|trans({}, 'ModulesAlliancePayAdmin') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>
</div>
{% endif %}
</div>

<script type="text/javascript">
    document.getElementById('sync-btn').addEventListener('click', async () => {
        const tableBody = document.querySelector('#extra-table tbody');
        tableBody.innerHTML = `
        <tr>
            <td colspan="3" class="text-center">
                Loading...
            </td>
        </tr>
    `;

        try {
            const response = await fetch('{{ sync_url }}');
            const result = await response.json();

            if (!result.success) {
                throw new Error(result.message || 'API error');
            }

            tableBody.innerHTML = '';

            if (result.items.length === 0) {
                tableBody.innerHTML = `
                <tr>
                    <td colspan="3" class="text-center text-muted">
                        Empty response
                    </td>
                </tr>
            `;
                return;
            }

            result.items.forEach(item => {
                tableBody.insertAdjacentHTML('beforeend', `
                <tr>
                    <td>${item.type}</td>
                    <td>${item.operationId}</td>
                    <td>${item.creationDateTime}</td>
                    <td>
                        <span class="badge badge-info">
                            ${item.status}
                        </span>
                    </td>
                </tr>
            `);
            });

        } catch (e) {
            tableBody.innerHTML = `
            <tr>
                <td colspan="3" class="text-danger text-center">
                    ${e.message}
                </td>
            </tr>
        `;
        }
    });
</script>
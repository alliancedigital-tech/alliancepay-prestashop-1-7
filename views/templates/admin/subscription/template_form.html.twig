{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-header-title">
                {{ (template ? 'Edit template' : 'New template')|trans({}, 'ModulesAlliancePayAdmin') }}
            </h3>
        </div>
        <div class="card-body">
            {% if locked %}
                <div class="alert alert-warning">{{ 'This template is used by plans and cannot be edited, archive it instead.'|trans({}, 'ModulesAlliancePayAdmin') }}</div>
            {% endif %}
            <form method="post" action="{{ template ? path('alliance.admin.subscription.template_edit', {id: template.id}) : path('alliance.admin.subscription.template_new') }}">
                <fieldset {{ locked ? 'disabled' }}>
                    <div class="form-group">
                        <label>{{ 'Code'|trans({}, 'ModulesAlliancePayAdmin') }}</label>
                        <input type="text" class="form-control" name="code" value="{{ data.code }}" required>
                    </div>
                    <div class="form-group">
                        <label>{{ 'Name'|trans({}, 'ModulesAlliancePayAdmin') }}</label>
                        <input type="text" class="form-control" name="name" value="{{ data.name }}" required>
                    </div>
                    <div class="form-group">
                        <label>{{ 'Category indicator'|trans({}, 'ModulesAlliancePayAdmin') }}</label>
                        <input type="text" class="form-control" name="category_indicator" value="{{ data.categoryIndicator }}" required>
                    </div>

                    <h4>{{ 'Schedule stages'|trans({}, 'ModulesAlliancePayAdmin') }}</h4>
                    <p class="text-muted">{{ 'TRIAL stages are charged 0, PAID stages are charged the plan price.'|trans({}, 'ModulesAlliancePayAdmin') }}</p>
                    <table class="table" id="alliance-template-rows">
                        <thead>
                            <tr>
                                <th>{{ 'Type'|trans({}, 'ModulesAlliancePayAdmin') }}</th>
                                <th>{{ 'From payment #'|trans({}, 'ModulesAlliancePayAdmin') }}</th>
                                <th>{{ 'To payment #'|trans({}, 'ModulesAlliancePayAdmin') }}</th>
                                <th>{{ 'Every'|trans({}, 'ModulesAlliancePayAdmin') }}</th>
                                <th>{{ 'Unit'|trans({}, 'ModulesAlliancePayAdmin') }}</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in data.rows %}
                                {% set i = loop.index0 %}
                                <tr>
                                    <td>
                                        <select class="form-control" name="rows[{{ i }}][type]">
                                            {% for type in stage_types %}<option value="{{ type }}" {{ row.type|default('') == type ? 'selected' }}>{{ type }}</option>{% endfor %}
                                        </select>
                                    </td>
                                    <td><input type="number" min="1" class="form-control" name="rows[{{ i }}][paymentNumberFrom]" value="{{ row.paymentNumberFrom|default('') }}"></td>
                                    <td><input type="number" min="1" class="form-control" name="rows[{{ i }}][paymentNumberTo]" value="{{ row.paymentNumberTo|default('') }}"></td>
                                    <td><input type="number" min="1" class="form-control" name="rows[{{ i }}][intervalValue]" value="{{ row.intervalValue|default('') }}"></td>
                                    <td>
                                        <select class="form-control" name="rows[{{ i }}][intervalUnit]">
                                            {% for unit in interval_units %}<option value="{{ unit }}" {{ row.intervalUnit|default('') == unit ? 'selected' }}>{{ unit }}</option>{% endfor %}
                                        </select>
                                    </td>
                                    <td><button type="button" class="btn btn-outline-danger btn-sm" data-remove>&times;</button></td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="alliance-template-add">+ {{ 'Add stage'|trans({}, 'ModulesAlliancePayAdmin') }}</button>
                </fieldset>
                <div class="mt-3">
                    {% if not locked %}<button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, 'ModulesAlliancePayAdmin') }}</button>{% endif %}
                    <a class="btn btn-outline-secondary" href="{{ path('alliance.admin.subscription.templates') }}">{{ 'Back'|trans({}, 'ModulesAlliancePayAdmin') }}</a>
                </div>
            </form>
        </div>
    </div>
    <script>
        (function () {
            var body = document.querySelector('#alliance-template-rows tbody');
            var types = {{ stage_types|json_encode|raw }};
            var units = {{ interval_units|json_encode|raw }};

            function options(list) {
                return list.map(function (item) { return '<option value="' + item + '">' + item + '</option>'; }).join('');
            }

            document.getElementById('alliance-template-add').addEventListener('click', function () {
                var i = body.children.length;
                body.insertAdjacentHTML('beforeend',
                    '<tr><td><select class="form-control" name="rows[' + i + '][type]">' + options(types) + '</select></td>' +
                    '<td><input type="number" min="1" class="form-control" name="rows[' + i + '][paymentNumberFrom]"></td>' +
                    '<td><input type="number" min="1" class="form-control" name="rows[' + i + '][paymentNumberTo]"></td>' +
                    '<td><input type="number" min="1" class="form-control" name="rows[' + i + '][intervalValue]"></td>' +
                    '<td><select class="form-control" name="rows[' + i + '][intervalUnit]">' + options(units) + '</select></td>' +
                    '<td><button type="button" class="btn btn-outline-danger btn-sm" data-remove>&times;</button></td></tr>');
            });

            body.addEventListener('click', function (event) {
                var button = event.target.closest('[data-remove]');
                if (button) { button.closest('tr').remove(); }
            });
        })();
    </script>
{% endblock %}
